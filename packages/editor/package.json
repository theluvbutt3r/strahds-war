    "@sw/tsconfig": "workspace:*",
    "@sw/vitest-config": "workspace:*",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
