{
  "name": "@sw/editor",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "TipTap 3 editor with custom Barovian extensions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
