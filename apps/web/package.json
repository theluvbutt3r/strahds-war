{
  "name": "@sw/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Next.js 16 — the public wiki and the admin panel",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "next build && playwright test --ui",
    "clean": "rm -rf .next .turbo coverage playwright-report test-results *.tsbuildinfo"
  },
  "dependencies": {
    "@sw/api-client": "workspace:*",
    "@sw/authz": "workspace:*",
    "@sw/content-render": "workspace:*",
    "@sw/design-tokens": "workspace:*",
    "@sw/editor": "workspace:*",
    "@sw/schemas": "workspace:*",
    "@sw/ui": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sw/tsconfig": "workspace:*",
    "@sw/vitest-config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
