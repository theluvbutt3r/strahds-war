# Strict linking: a workspace package can only import what its own package.json declares.
# This is the mechanism that makes package boundaries physical rather than advisory —
# an undeclared workspace import fails to resolve instead of silently working via hoisting.
#
# Note we do NOT set hoist=false. pnpm's default already isolates workspace packages from
# each other, which is the property we want; disabling the private .pnpm hoist as well only
# breaks third-party packages that under-declare their own deps (endemic in the React/Next
# ecosystem) and buys us no additional boundary enforcement.
node-linker=isolated
shamefully-hoist=false

# Peer dependencies: install them automatically, and do not fail on a mismatch.
# The React/Next ecosystem declares peer ranges loosely enough that strict mode produces
# mostly false alarms; the versions that actually matter are pinned exactly in each
# package.json, which is the check that carries the weight.
#
# (There was a comment here claiming these two lines refuse an install that would change
# the lockfile in CI. They do not — no frozen-lockfile setting exists in this file at all.
# CI passes `--frozen-lockfile` explicitly on the install step, which is where that
# behaviour actually comes from.)
strict-peer-dependencies=false
auto-install-peers=true

# Keep the engines field honest rather than decorative.
engine-strict=true
