# Copy to .env and fill in. Real values never enter the repo — see docs/PLAN.md §10.
# Every variable used by any workspace is documented here, including ones not yet read,
# so that "what does this deployment need?" has a single answer.
#
# ADDING A VARIABLE HERE? Add it to turbo.json's `build.env` in the same commit if it can
# change build output. Turborepo hashes only the variables it is told about, so an
# undeclared one means a cache hit that ships the old value — and for NEXT_PUBLIC_*, which
# Next inlines into the client bundle, nothing in app source reads process.env, so the
# turbo/no-undeclared-env-vars lint rule cannot catch the omission for you.

# ---- services/api ---------------------------------------------------------------
# The ONLY place a database URL is legitimate. If you find yourself adding one of these
# to apps/web, the design has gone wrong — read PLAN.md §4 before working around it.
DATABASE_URL="postgresql://user:password@host/strahds_war?sslmode=require"

# Neon branch used by integration tests. Should never point at production.
DATABASE_URL_TEST="postgresql://user:password@host/strahds_war_test?sslmode=require"

PORT=3001

# ---- auth (Phase 1) -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_ME"
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

DISCORD_CLIENT_ID="your-discord-client-id-here"
DISCORD_CLIENT_SECRET="REPLACE_ME"
# Members of this guild are auto-granted the Player role.
DISCORD_GUILD_ID="your-guild-id-here"

# ---- apps/web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- media, Cloudflare R2 (Phase 4) ---------------------------------------------
R2_ACCOUNT_ID="your-account-id-here"
R2_ACCESS_KEY_ID="REPLACE_ME"
R2_SECRET_ACCESS_KEY="REPLACE_ME"
R2_BUCKET="strahds-war-media"
R2_PUBLIC_URL="https://media.example.com"

# ---- observability (Phase 6) ----------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"

# ---- CI only --------------------------------------------------------------------
# Turborepo remote cache. Not needed for local development.
TURBO_TOKEN=""
TURBO_TEAM=""
